SPRING_PROFILES_ACTIVE=prod
PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://<dpg-xxxx-a>:5432/redbank_db
SPRING_DATASOURCE_USERNAME=redbank_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password
POSTGRES_USERNAME=redbank_user
POSTGRES_PASSWORD=your_secure_db_password

# Admin User Seed Password Hash (BCrypt)
ADMIN_PASSWORD_HASH=$2a$10$e0MYzXyjpJS7Pd0RVvHwHe1W4UvV9f...

# Security RSA Keys (PEM Formatted for JWT Token Generation & Verification)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"

# AI & Anomaly Risk Detection API Keys
GEMINI_API_KEY=your_google_gemini_api_key
IP_GEOLOCATION_API_KEY=your_ipgeolocation_api_key
ABUSE_IPDB_API_KEY=your_abuseipdb_api_key

# Frontend Allowed CORS Origins (Comma-separated for multiple domains)
CORS_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app
